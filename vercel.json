{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/website/dashboard.html"
    },
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/animations.js",
      "destination": "/website/animations.js"
    },
    {
      "source": "/downloads/:path*",
      "destination": "/website/downloads/:path*"
    }
  ]
}
